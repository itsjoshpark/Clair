{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "ClairRuntimeTests", "target-membership": [ "ClairRuntimeTests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/ClairRuntimeTests.xctest", "id": "C1A2000000000000000000F1", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "ClairRuntimeTests",
      "id": "C1A2000000000000000000A1",
      "product": "Products/ClairRuntimeTests.xctest",
      "product-type": "bundle.ui-testing",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "ClairRuntimeTests.entitlements",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.joshuapark.Clair.RuntimeTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ARCHS": "arm64",
    "CLANG_ENABLE_MODULES": "YES",
    "CODE_SIGN_IDENTITY": "-",
    "CODE_SIGN_STYLE": "Manual",
    "DEBUG_INFORMATION_FORMAT": "dwarf",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "15.6",
    "ONLY_ACTIVE_ARCH": "YES",
    "SDKROOT": "macosx",
    "SUPPORTED_PLATFORMS": "macosx",
    "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
    "SWIFT_OPTIMIZATION_LEVEL": "-Onone",
    "SWIFT_TREAT_WARNINGS_AS_ERRORS": "YES",
    "SWIFT_VERSION": "6.0",
  },
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
