# Keep Clair to its own data and configuration: the places Chromium looks for or
# writes data outside its profile folder now name Clair, so Clair can't pick up
# another browser's files, or leave its own in another browser's folders. Found
# by tracing a first launch with fs_usage and searching the framework's strings.
#
# - Initial preferences: /Library/Application Support/Chromium
# - External extensions: /Library/Application Support/Google/Chrome
# - Native messaging hosts: /Library/Application Support/Chromium
# - Brand code: /Library/Google and ~/Library/Google
# - Cloud management: /Library/Google/Chrome, ~/Library/Application Support/Google
#   and the managed preferences of com.google.Chrome
# - Web app shortcuts: ~/Applications/Chromium Apps.localized
# - Device-bound session keys: the org.chromium.Chromium keychain access group

--- a/chrome/common/chrome_paths.cc
+++ b/chrome/common/chrome_paths.cc
@@ -434,8 +434,7 @@
         return false;
       }
 
-      cur = cur.Append(FILE_PATH_LITERAL("Google"))
-                .Append(FILE_PATH_LITERAL("Chrome"))
+      cur = cur.Append(FILE_PATH_LITERAL("Clair"))
                 .Append(FILE_PATH_LITERAL("External Extensions"));
 #else
       if (!base::PathService::Get(base::DIR_MODULE, &cur)) {
@@ -460,7 +459,7 @@
           "/Library/Google/ChromeForTesting/NativeMessagingHosts"));
 #else
       cur = base::FilePath(FILE_PATH_LITERAL(
-          "/Library/Application Support/Chromium/NativeMessagingHosts"));
+          "/Library/Application Support/Clair/NativeMessagingHosts"));
 #endif
 #else  // BUILDFLAG(IS_MAC)
 #if BUILDFLAG(GOOGLE_CHROME_BRANDING)
--- a/chrome/browser/mac/initial_prefs.mm
+++ b/chrome/browser/mac/initial_prefs.mm
@@ -28,9 +28,9 @@
     "Google Chrome Master Preferences";
 #else
 const NSSearchPathDirectory kSearchPath = NSApplicationSupportDirectory;
-const char kInitialPreferencesDirectory[] = "Chromium";
-const char kInitialPreferencesFileName[] = "Chromium Initial Preferences";
-const char kLegacyInitialPreferencesFileName[] = "Chromium Master Preferences";
+const char kInitialPreferencesDirectory[] = "Clair";
+const char kInitialPreferencesFileName[] = "Clair Initial Preferences";
+const char kLegacyInitialPreferencesFileName[] = "Clair Master Preferences";
 #endif  // BUILDFLAG(GOOGLE_CHROME_BRANDING)
 
 }  // namespace
--- a/chrome/browser/google/google_brand_mac.mm
+++ b/chrome/browser/google/google_brand_mac.mm
@@ -37,7 +37,8 @@
   // If there is a system brand file, use it.
   NSFileManager* fm = NSFileManager.defaultManager;
   NSString* system_brand_file =
-      [@"/Library/Google/Google Chrome Brand.plist" stringByStandardizingPath];
+      [@"/Library/Application Support/Clair/Clair Brand.plist"
+          stringByStandardizingPath];
   if ([fm fileExistsAtPath:system_brand_file]) {
     return ReadBrandFile(system_brand_file);
   }
@@ -62,7 +63,8 @@
 
   // Otherwise, use the user brand code file, if present.
   NSString* user_brand_file =
-      [@"~/Library/Google/Google Chrome Brand.plist" stringByStandardizingPath];
+      [@"~/Library/Application Support/Clair/Clair Brand.plist"
+          stringByStandardizingPath];
   if ([fm fileExistsAtPath:user_brand_file]) {
     return ReadBrandFile(user_brand_file);
   }
