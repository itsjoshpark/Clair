# Peeks end with the session (add-peek design D9). Clair tags a Peek in what
# Chromium saves for the session and for Reopen Closed Window, and both leave
# tagged tabs out when they restore, so a Peek never comes back, whether the
# window closed, Clair quit, a page's leave-page confirmation held things up,
# or Clair crashed. Expanding a Peek clears its tag.
#
# - session_service_base.cc: the session file's rebuild writes the tag again;
#   it otherwise keeps no tab extra data.
# - session_restore.cc: drops tagged tabs before restoring windows.
# - browser_live_tab_context.cc: tags a Peek's extra data for tab restore.
# - tab_restore_service_helper.cc: a closing window's entry leaves tagged tabs
#   out. The key is spelled out here, since components can't include chrome.

--- a/chrome/browser/sessions/session_service_base.cc
+++ b/chrome/browser/sessions/session_service_base.cc
@@ -20,6 +20,7 @@
 #include "base/task/sequenced_task_runner.h"
 #include "build/build_config.h"
 #include "chrome/browser/apps/app_service/web_contents_app_id_utils.h"
+#include "chrome/browser/clair/window/clair_peek_session.h"
 #include "chrome/browser/browser_process.h"
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/sessions/session_service_base_observer.h"
@@ -632,6 +633,14 @@
       sessions::CreateLastActiveTimeCommand(session_id,
                                             tab->GetLastActiveTime()));
 
+  // Clair: a Peek keeps its tag through a rebuild, so session restore leaves
+  // it out (add-peek design D9).
+  if (clair::IsPeekTab(tab)) {
+    command_storage_manager()->AppendRebuildCommand(
+        sessions::CreateAddTabExtraDataCommand(
+            session_id, clair::kPeekSessionKey, "1"));
+  }
+
   // TODO(stahon@microsoft.com) This might be movable to SessionService
   // when Chrome OS uses AppSessionService for app restores.
   // For now it needs to stay to support SessionService restoring apps.
