# Throwaway line to change the engine key.
# Show Clair's version on the About page and chrome://version (change 1 design
# D3, task 3.2): the Clair version and build number, read from the main bundle's
# Info.plist at run time by overlay/chrome/browser/clair/clair_version.mm, and
# the Chromium and ungoogled-chromium versions, labelled as the engine.
#
# Adapted from Helium's add-helium-versioning.patch (GPL-3.0). Helium compiles
# its version in; Clair doesn't, so that packaging can set it without changing
# the engine. version_info and the user agent keep the Chromium version.

--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -1527,6 +1527,8 @@
       "clair/ClairHost.h",
       "clair/clair_native_layer.h",
       "clair/clair_native_layer.mm",
+      "clair/clair_version.h",
+      "clair/clair_version.mm",
       "clair/ungoogled_version.h",
       "file_select_helper_mac.mm",
       "fullscreen_mac.mm",
--- a/chrome/browser/ui/webui/version/version_ui.cc
+++ b/chrome/browser/ui/webui/version/version_ui.cc
@@ -20,6 +20,7 @@
