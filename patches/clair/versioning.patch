 #include "chrome/browser/ui/webui/version/version_handler.h"
 #include "chrome/common/channel_info.h"
@@ -247,6 +248,9 @@
                                   VersionProcessorVariation());
 
   // Data strings.
+  html_source->AddString("clair_version", clair::GetVersionString());
+  html_source->AddString("clair_engine_version",
