# Keep Clair's storage encryption key in its own "Clair Safe Storage"
# keychain item instead of Chromium's.
#
# Adapted from Helium's patches/helium/macos/change-keychain-name.patch
# (GPL-3.0, The Helium Authors), with Clair's service and account names.

--- a/components/os_crypt/common/keychain_password_mac.mm
+++ b/components/os_crypt/common/keychain_password_mac.mm
@@ -31,13 +31,8 @@
 // These two strings ARE indeed user facing.  But they are used to access
 // the encryption keyword.  So as to not lose encrypted data when system
 // locale changes we DO NOT LOCALIZE.
-#if BUILDFLAG(GOOGLE_CHROME_BRANDING)
-const char kDefaultServiceName[] = "Chrome Safe Storage";
-const char kDefaultAccountName[] = "Chrome";
-#else
-const char kDefaultServiceName[] = "Chromium Safe Storage";
-const char kDefaultAccountName[] = "Chromium";
-#endif
+const char kDefaultServiceName[] = "Clair Safe Storage";
+const char kDefaultAccountName[] = "Clair";
 
 // These values are persisted to logs. Entries should not be renumbered and
 // numeric values should never be reused.
